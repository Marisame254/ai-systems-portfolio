# === LLM provider selection ===
ENVIRONMENT=dev                 # dev → Ollama local, prod → OpenAI

# === Ollama (dev) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# === OpenAI (prod) ===
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# === Embeddings (mirror chat provider per ENVIRONMENT) ===
# Dev (Ollama):    requires `ollama pull nomic-embed-text` once. Dim=768.
# Prod (OpenAI):   uses OPENAI_API_KEY. Dim=1536.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# === RAG ===
RAG_MAX_DOCS_PER_USER=3
RAG_MAX_UPLOAD_BYTES=10485760
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=4

# === Agent tools ===
TAVILY_API_KEY=                 # https://tavily.com — optional; chat agent runs without tools if empty

# === Database ===
DATABASE_URL=postgresql+asyncpg://portfolio:portfolio@localhost:5432/portfolio
REDIS_URL=redis://localhost:6379

# === Backend ===
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8000
