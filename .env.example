# === LLM provider selection ===
ENVIRONMENT=dev                 # dev → Ollama local, prod → OpenAI

# === Ollama (dev) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# === OpenAI (prod) ===
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# === Embeddings (mirror chat provider per ENVIRONMENT) ===
# Dev (Ollama):    requires `ollama pull nomic-embed-text` once. Dim=768.
# Prod (OpenAI):   uses OPENAI_API_KEY. Dim=1536.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# === RAG ===
RAG_MAX_DOCS_PER_USER=3
RAG_MAX_UPLOAD_BYTES=10485760
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=4
RAG_MIN_SIMILARITY=0.2          # chunks below this cosine similarity (0–1) are dropped; tune per embedding model

# === Long-term memory ===
MEMORY_MAX_PER_USER=50

# === Agent tools ===
TAVILY_API_KEY=                 # https://tavily.com — optional; chat agent runs without tools if empty

# === Rate limits (requests per window, per client IP) ===
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CHAT=15
RATE_LIMIT_RAG_QUERY=15
RATE_LIMIT_RAG_UPLOAD=6
RATE_LIMIT_MEMORY_WRITE=20

# === Database ===
# User, password and db name match the postgres service in docker-compose.yml.
# If another Postgres already uses 5432, set POSTGRES_PORT=5433 and use that port in DATABASE_URL.
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://portfolio:portfolio@localhost:5432/portfolio

# === Backend ===
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# === Frontend ===
NEXT_PUBLIC_API_URL=http://localhost:8000
